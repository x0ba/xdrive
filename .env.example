# Clerk (optional — disabled by default for personal/tailnet deployments)
# Set VITE_ENABLE_CLERK=true and provide both keys to enable Clerk auth
VITE_ENABLE_CLERK=false
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (optional)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# OpenCode Go (optional — or connect from Models & Providers in the UI)
OPENCODE_API_KEY=
