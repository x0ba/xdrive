# Clerk (optional — disabled by default for personal/tailnet deployments)
# Set VITE_ENABLE_CLERK=true and provide both keys to enable Clerk auth
VITE_ENABLE_CLERK=false
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local Drive directory (optional — defaults to ./marble-drive)
XDRIVE_DRIVE_DIR=

# Local Drive backup destination & config dirs (optional — defaults to ~/.xdrive/backups and ~/.xdrive/backup)
XDRIVE_BACKUP_DIR=
XDRIVE_BACKUP_CONFIG_DIR=

# Google Antigravity ACP binary override (optional — defaults to `agy` on PATH or ACP Registry binary)
XDRIVE_ANTIGRAVITY_BIN=

# OpenCode ACP binary override (optional — defaults to `opencode` on PATH)
# Run `opencode auth login` in your terminal to sign in with OpenCode Go; xDrive never stores an OpenCode API key.
XDRIVE_OPENCODE_BIN=

# OpenCode Go direct-HTTP fallback ONLY when the OpenCode CLI is not installed (optional)
OPENCODE_API_KEY=
