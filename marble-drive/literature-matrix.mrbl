<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<meta name="marble:design-system" content="document-design-system.mrbl,document-donts-system.mrbl">
<title>Literature Review &amp; Synthesis Matrix</title>
<style>
:root { --xd-canvas:#ffffff;--xd-rail:#f7f8fa;--xd-elevated:#f1f3f7;--xd-surface-hover:#eaeef4;--xd-surface-active:#e2e7f0;--xd-ink:#0f131a;--xd-ink-secondary:#4a5568;--xd-ink-muted:#718096;--xd-border:#e3e8ee;--xd-border-strong:#cbd5e1;--xd-accent:#5e6ad2;--xd-accent-hover:#4e5ac0;--xd-accent-soft:rgba(94,106,210,0.12);--xd-accent-border:rgba(94,106,210,0.35);--xd-commit:#1f9d6b;--xd-commit-soft:rgba(31,157,107,0.12);--xd-sketch:#d9822b;--xd-sketch-soft:rgba(217,130,43,0.14);--xd-danger:#e5484d;--xd-danger-soft:rgba(229,72,77,0.12);--ink:#0f131a;--muted:#4a5568;--faint:#718096;--line:#e3e8ee;--line-strong:#cbd5e1;--paper:#ffffff;--panel:#f7f8fa;--panel-2:#f1f3f7;--accent:#5e6ad2;--accent-2:#1f9d6b;--accent-soft:rgba(94,106,210,0.12);--good:#1f9d6b;--warn:#d9822b;--danger:#e5484d;--radius:6px;--shadow:none;--serif:"Newsreader",Georgia,Cambria,"Times New Roman",serif;--sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;--mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; }
@media (prefers-color-scheme: dark) { :root { --xd-canvas:#0b0c0e;--xd-rail:#101216;--xd-elevated:#161920;--xd-surface-hover:#1c2029;--xd-surface-active:#232834;--xd-ink:#f3f5f8;--xd-ink-secondary:#a2abb8;--xd-ink-muted:#6e7785;--xd-border:#22252e;--xd-border-strong:#313644;--xd-accent:#5e6ad2;--xd-accent-hover:#6e7ae2;--xd-accent-soft:rgba(94,106,210,0.16);--xd-accent-border:rgba(94,106,210,0.45);--xd-commit:#2ea071;--xd-commit-soft:rgba(46,160,113,0.16);--xd-sketch:#e59934;--xd-sketch-soft:rgba(229,153,52,0.18);--xd-danger:#e5484d;--xd-danger-soft:rgba(229,72,77,0.16);--ink:#f3f5f8;--muted:#a2abb8;--faint:#6e7785;--line:#22252e;--line-strong:#313644;--paper:#0b0c0e;--panel:#101216;--panel-2:#161920;--accent:#5e6ad2;--accent-2:#2ea071;--accent-soft:rgba(94,106,210,0.16);--good:#2ea071;--warn:#e59934;--danger:#e5484d;--radius:6px;--shadow:none; } }
html[data-xdrive-theme="light"] { --xd-canvas:#ffffff;--xd-rail:#f7f8fa;--xd-elevated:#f1f3f7;--xd-surface-hover:#eaeef4;--xd-surface-active:#e2e7f0;--xd-ink:#0f131a;--xd-ink-secondary:#4a5568;--xd-ink-muted:#718096;--xd-border:#e3e8ee;--xd-border-strong:#cbd5e1;--xd-accent:#5e6ad2;--xd-accent-hover:#4e5ac0;--xd-accent-soft:rgba(94,106,210,0.12);--xd-accent-border:rgba(94,106,210,0.35);--xd-commit:#1f9d6b;--xd-commit-soft:rgba(31,157,107,0.12);--xd-sketch:#d9822b;--xd-sketch-soft:rgba(217,130,43,0.14);--xd-danger:#e5484d;--xd-danger-soft:rgba(229,72,77,0.12);--ink:#0f131a;--muted:#4a5568;--faint:#718096;--line:#e3e8ee;--line-strong:#cbd5e1;--paper:#ffffff;--panel:#f7f8fa;--panel-2:#f1f3f7;--accent:#5e6ad2;--accent-2:#1f9d6b;--accent-soft:rgba(94,106,210,0.12);--good:#1f9d6b;--warn:#d9822b;--danger:#e5484d;--radius:6px;--shadow:none;--serif:"Newsreader",Georgia,Cambria,"Times New Roman",serif;--sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;--mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; color-scheme: light; }
html[data-xdrive-theme="dark"] { --xd-canvas:#0b0c0e;--xd-rail:#101216;--xd-elevated:#161920;--xd-surface-hover:#1c2029;--xd-surface-active:#232834;--xd-ink:#f3f5f8;--xd-ink-secondary:#a2abb8;--xd-ink-muted:#6e7785;--xd-border:#22252e;--xd-border-strong:#313644;--xd-accent:#5e6ad2;--xd-accent-hover:#6e7ae2;--xd-accent-soft:rgba(94,106,210,0.16);--xd-accent-border:rgba(94,106,210,0.45);--xd-commit:#2ea071;--xd-commit-soft:rgba(46,160,113,0.16);--xd-sketch:#e59934;--xd-sketch-soft:rgba(229,153,52,0.18);--xd-danger:#e5484d;--xd-danger-soft:rgba(229,72,77,0.16);--ink:#f3f5f8;--muted:#a2abb8;--faint:#6e7785;--line:#22252e;--line-strong:#313644;--paper:#0b0c0e;--panel:#101216;--panel-2:#161920;--accent:#5e6ad2;--accent-2:#2ea071;--accent-soft:rgba(94,106,210,0.16);--good:#2ea071;--warn:#e59934;--danger:#e5484d;--radius:6px;--shadow:none; color-scheme: dark; }
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body {
  background: var(--paper); color: var(--ink);
  font: 14.5px/1.6 var(--sans); letter-spacing: -0.006em;
  -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
}
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 2px; }
[data-marble-editable]:focus { outline: none; box-shadow: inset 0 -1.5px 0 var(--accent); }
.kicker {
  margin: 0 0 .3rem; color: var(--muted);
  font: 500 .78rem/1.4 var(--sans); letter-spacing: -0.004em; text-transform: none;
}
h1 {
  font-family: var(--serif); font-size: 2rem; font-weight: 500;
  letter-spacing: -0.024em; line-height: 1.12; margin: 0; color: var(--ink);
}
h2 {
  font-family: var(--serif); font-size: 1.25rem; font-weight: 500;
  letter-spacing: -0.016em; line-height: 1.24; margin: 0 0 .4rem; color: var(--ink);
}
h3 {
  font-family: var(--sans); font-size: .92rem; font-weight: 600;
  letter-spacing: -0.01em; line-height: 1.35; margin: 0 0 .3rem; color: var(--ink);
}
p { margin: 0; max-width: 68ch; }
.lede { color: var(--muted); max-width: 62ch; font-size: .96rem; line-height: 1.6; }
marble-alt { display: block; }
marble-alt > [data-marble-alt] { display: none; }
marble-alt[data-marble-active="v1"] > [data-marble-alt="v1"],
marble-alt[data-marble-active="v2"] > [data-marble-alt="v2"],
marble-alt[data-marble-active="v3"] > [data-marble-alt="v3"],
marble-alt[data-marble-active="v4"] > [data-marble-alt="v4"],
marble-alt[data-marble-active="v5"] > [data-marble-alt="v5"],
marble-alt[data-marble-active="v6"] > [data-marble-alt="v6"] { display: block; }
marble-alt:not([data-marble-active]) > [data-marble-alt]:first-child { display: block; }
[data-marble-sortable] { padding-left: 1.4rem; }
.pill, .choose button, .tex-edit, .add {
  border: 1px solid var(--line); background: var(--panel); border-radius: 4px;
  padding: .2rem .55rem; font: 500 .76rem/1.35 var(--sans); color: var(--muted);
  transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
}
.pill:hover, .choose button:hover, .tex-edit:hover, .add:hover {
  border-color: var(--line-strong); color: var(--ink);
}
.choose { display: inline-flex; gap: .2rem; flex-wrap: wrap; padding: 2px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); }
.choose button { border-color: transparent; background: transparent; }
.choose button[aria-pressed="true"] { background: var(--paper); color: var(--ink); border-color: var(--line); }
.add { border-style: dashed; color: var(--accent); background: transparent; }
.card, section.block {
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  padding: .95rem 1.1rem; box-shadow: none;
}


  main { max-width: 68rem; margin: 0 auto; padding: 2rem 1.4rem 4rem; }
  h1 { font-size: 2rem; margin-bottom: .35rem; }
  .filters { margin: 1rem 0; }
  table { width: 100%; border-collapse: collapse; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  th, td { text-align: left; padding: .6rem .75rem; border-bottom: 1px solid var(--line); vertical-align: top; font-size: .88rem; }
  th { font: 500 .76rem/1.3 var(--sans); color: var(--muted); background: var(--panel-2); }
  tr[data-status="keep"] { --mark: var(--good); }
  tr[data-status="reading"] { --mark: var(--accent); }
  tr[data-status="drop"] { --mark: var(--danger); }
  tbody tr { box-shadow: inset 2.5px 0 0 var(--mark, var(--line)); }
  .matrix.marble-derived tr.marble-dim { display: none; }
  .take { color: var(--ink); }
  .add { margin-top: .85rem; }
  .foot { margin-top: .85rem; color: var(--muted); font-size: .84rem; }
  </style>
</head>
<body>
<main data-marble-id="matrix-shell" class="matrix" data-filter="all">
  <p data-marble-id="matrix-kicker" class="kicker">Synthesis</p>
  <h1 data-marble-id="matrix-title" data-marble-editable>Literature Review &amp; Synthesis Matrix</h1>
  <p data-marble-id="matrix-lede" class="lede" data-marble-editable>Five papers, one question: what has to be true for a bigger model to be a better reasoner, and which of these results actually says that.</p>
  <div data-marble-id="matrix-filters" class="filters">
    <span data-marble-id="filter-choose" class="choose" data-marble-choose="data-filter" data-marble-of="[data-marble-id=matrix-shell]">
      <button data-marble-id="filter-all" type="button" data-marble-value="all">All</button>
      <button data-marble-id="filter-reading" type="button" data-marble-value="reading">Reading</button>
      <button data-marble-id="filter-keep" type="button" data-marble-value="keep">Keep</button>
      <button data-marble-id="filter-drop" type="button" data-marble-value="drop">Drop</button>
    </span>
  </div>
  <table data-marble-id="paper-table">
    <thead data-marble-id="paper-head">
      <tr data-marble-id="paper-head-row">
        <th data-marble-id="th-paper">Paper</th>
        <th data-marble-id="th-venue">Venue</th>
        <th data-marble-id="th-method">Method</th>
        <th data-marble-id="th-status">Status</th>
        <th data-marble-id="th-take">Takeaway</th>
      </tr>
    </thead>
    <tbody data-marble-id="paper-body" id="paper-body" data-marble-sortable="papers">
      <tr data-marble-id="row-vaswani" data-status="keep" data-marble-removable>
      <td data-marble-id="row-vaswani-name" data-marble-editable>Vaswani et al. 2017</td>
      <td data-marble-id="row-vaswani-venue" data-marble-editable>NeurIPS</td>
      <td data-marble-id="row-vaswani-method" data-marble-editable>Scaled dot-product attention</td>
      <td data-marble-id="row-vaswani-status">
        <span data-marble-id="row-vaswani-choose" class="choose" data-marble-choose="data-status" data-marble-look="off" data-marble-of="[data-marble-id=row-vaswani]">
          <button data-marble-id="row-vaswani-reading" type="button" data-marble-value="reading">Reading</button>
          <button data-marble-id="row-vaswani-keep" type="button" data-marble-value="keep">Keep</button>
          <button data-marble-id="row-vaswani-drop" type="button" data-marble-value="drop">Drop</button>
        </span>
      </td>
      <td data-marble-id="row-vaswani-take" class="take" data-marble-editable>The interface is the residual stream. Attention is how it moves, not what it stores.</td>
    </tr>
      <tr data-marble-id="row-kaplan" data-status="reading" data-marble-removable>
      <td data-marble-id="row-kaplan-name" data-marble-editable>Kaplan et al. 2020</td>
      <td data-marble-id="row-kaplan-venue" data-marble-editable>arXiv</td>
      <td data-marble-id="row-kaplan-method" data-marble-editable>Power-law loss vs compute</td>
      <td data-marble-id="row-kaplan-status">
        <span data-marble-id="row-kaplan-choose" class="choose" data-marble-choose="data-status" data-marble-look="off" data-marble-of="[data-marble-id=row-kaplan]">
          <button data-marble-id="row-kaplan-reading" type="button" data-marble-value="reading">Reading</button>
          <button data-marble-id="row-kaplan-keep" type="button" data-marble-value="keep">Keep</button>
          <button data-marble-id="row-kaplan-drop" type="button" data-marble-value="drop">Drop</button>
        </span>
      </td>
      <td data-marble-id="row-kaplan-take" class="take" data-marble-editable>Loss falls as a power of compute. It does not say the model got wiser.</td>
    </tr>
      <tr data-marble-id="row-hoffmann" data-status="keep" data-marble-removable>
      <td data-marble-id="row-hoffmann-name" data-marble-editable>Hoffmann et al. 2022</td>
      <td data-marble-id="row-hoffmann-venue" data-marble-editable>NeurIPS</td>
      <td data-marble-id="row-hoffmann-method" data-marble-editable>Compute-optimal tokens</td>
      <td data-marble-id="row-hoffmann-status">
        <span data-marble-id="row-hoffmann-choose" class="choose" data-marble-choose="data-status" data-marble-look="off" data-marble-of="[data-marble-id=row-hoffmann]">
          <button data-marble-id="row-hoffmann-reading" type="button" data-marble-value="reading">Reading</button>
          <button data-marble-id="row-hoffmann-keep" type="button" data-marble-value="keep">Keep</button>
          <button data-marble-id="row-hoffmann-drop" type="button" data-marble-value="drop">Drop</button>
        </span>
      </td>
      <td data-marble-id="row-hoffmann-take" class="take" data-marble-editable>Most models in the earlier curve were under-trained. Re-fit before you quote them.</td>
    </tr>
      <tr data-marble-id="row-wei" data-status="reading" data-marble-removable>
      <td data-marble-id="row-wei-name" data-marble-editable>Wei et al. 2022</td>
      <td data-marble-id="row-wei-venue" data-marble-editable>NeurIPS</td>
      <td data-marble-id="row-wei-method" data-marble-editable>Chain of thought</td>
      <td data-marble-id="row-wei-status">
        <span data-marble-id="row-wei-choose" class="choose" data-marble-choose="data-status" data-marble-look="off" data-marble-of="[data-marble-id=row-wei]">
          <button data-marble-id="row-wei-reading" type="button" data-marble-value="reading">Reading</button>
          <button data-marble-id="row-wei-keep" type="button" data-marble-value="keep">Keep</button>
          <button data-marble-id="row-wei-drop" type="button" data-marble-value="drop">Drop</button>
        </span>
      </td>
      <td data-marble-id="row-wei-take" class="take" data-marble-editable>A prompt can move accuracy without moving the training loss. Treat it as a method, not a scale law.</td>
    </tr>
      <tr data-marble-id="row-dao" data-status="keep" data-marble-removable>
      <td data-marble-id="row-dao-name" data-marble-editable>Dao et al. 2022</td>
      <td data-marble-id="row-dao-venue" data-marble-editable>ICML</td>
      <td data-marble-id="row-dao-method" data-marble-editable>IO-aware exact attention</td>
      <td data-marble-id="row-dao-status">
        <span data-marble-id="row-dao-choose" class="choose" data-marble-choose="data-status" data-marble-look="off" data-marble-of="[data-marble-id=row-dao]">
          <button data-marble-id="row-dao-reading" type="button" data-marble-value="reading">Reading</button>
          <button data-marble-id="row-dao-keep" type="button" data-marble-value="keep">Keep</button>
          <button data-marble-id="row-dao-drop" type="button" data-marble-value="drop">Drop</button>
        </span>
      </td>
      <td data-marble-id="row-dao-take" class="take" data-marble-editable>The speedup is real and the function is the same. Do not cite it as a new algorithm.</td>
    </tr>
    </tbody>
  </table>
  <button data-marble-id="add-paper" class="add" type="button" data-marble-add="#tpl-paper" data-marble-into="#paper-body">+ Add paper</button>
  <template data-marble-id="tpl-paper" id="tpl-paper">
    <tr data-marble-removable data-status="reading">
      <td data-marble-editable>New paper</td>
      <td data-marble-editable>Venue</td>
      <td data-marble-editable>Method</td>
      <td><span class="choose" data-marble-choose="data-status" data-marble-look="off"><button type="button" data-marble-value="reading">Reading</button><button type="button" data-marble-value="keep">Keep</button><button type="button" data-marble-value="drop">Drop</button></span></td>
      <td data-marble-editable>The sentence you would still believe in a year.</td>
    </tr>
  </template>
  <p data-marble-id="matrix-note" class="foot" data-marble-note><span data-marble-id="matrix-note-body" data-marble-note-body data-marble-editable>Status is a decision, so it is filed. The filter is only where you are looking.</span></p>
</main>
<script>
(function () {
  function boot(start) {
    if (window.marble) start(window.marble);
    else document.addEventListener('marble:ready', function () { start(window.marble); }, { once: true });
  }
  boot(function (marble) {
    var MID = 'data-marble-' + 'id';
    var AFFORDANCES = [
      'data-marble-editable',
      'data-marble-sortable',
      'data-marble-canvas',
      'data-marble-resizable',
      'data-marble-removable',
      'data-marble-add',
      'data-marble-toggle',
      'data-marble-choose',
      'data-marble-expand',
      'data-marble-step',
      'data-marble-note'
    ];
    if (marble && marble.address) {
      marble.address(document.querySelectorAll(AFFORDANCES.map(function (a) { return '[' + a + ']'; }).join(',')));
    }
    function qMarble(id) { return document.querySelector('[' + MID + '="' + id + '"]'); }
    var shell = qMarble('matrix-shell');
    function derive() {
      shell.classList.add('marble-derived');
      var filter = shell.getAttribute('data-filter') || 'all';
      var rows = document.querySelectorAll('#paper-body > tr');
      for (var i = 0; i < rows.length; i++) {
        var status = rows[i].getAttribute('data-status') || '';
        rows[i].classList.toggle('marble-dim', filter !== 'all' && status !== filter);
      }
    }
    marble.register(derive);
    new MutationObserver(derive).observe(shell, { attributes: true, attributeFilter: ['data-filter'] });
    new MutationObserver(derive).observe(document.getElementById('paper-body'), { attributes: true, subtree: true, attributeFilter: ['data-status'] });
    derive();
    });
})();
</script>
</body>
</html>
